// Chola Chela Photography - Production Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("client") // client | admin | technician
  active        Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  photos        Photo[]
  projects      Project[]
  orders        Order[]
  confirmedPayments Order[] @relation("PaymentConfirmedBy")
  approvedOrders    Order[] @relation("ApprovedBy")
}

model Photo {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  publicId      String
  url           String
  secureUrl     String
  width         Int?
  height        Int?
  format        String?
  bytes         Int?
  originalName  String?

  createdAt     DateTime  @default(now())
  projectPhotos ProjectPhoto[]
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  templateId    String
  status        String    @default("draft")
  pages         String
  autoGenerated Boolean   @default(false)
  coverColor    String?
  coverText     String?   // Custom cover wording
  pageCount     Int       @default(12)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projectPhotos ProjectPhoto[]
  order         Order?
}

model ProjectPhoto {
  id        String  @id @default(cuid())
  projectId String
  photoId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  photo     Photo   @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([projectId, photoId])
}

model Material {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Int      // ngwee (Kwacha * 100)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id])

  amount          Int
  currency        String    @default("ZMW")

  // Specs
  bookSize        String
  coverType       String
  paperType       String
  materialId      String?
  material        Material? @relation(fields: [materialId], references: [id])
  materialName    String?   // snapshot of material name at order time
  pageCount       Int
  quantity        Int       @default(1)

  // Payment
  paymentStatus   String    @default("pending") // pending | awaiting_confirmation | paid | failed | refunded
  paymentMethod   String?   // mastercard | mobile_money | pay_later
  paymentProvider String?
  paymentId       String?
  receiptNumber   String?
  paymentConfirmedAt DateTime?
  paymentConfirmedById String?
  paymentConfirmedBy User?  @relation("PaymentConfirmedBy", fields: [paymentConfirmedById], references: [id])

  // Workflow status:
  // submitted | awaiting_payment | payment_confirmed | approved_for_print
  // printing | printing_completed | shipped | delivered | cancelled
  status          String    @default("submitted")
  approvedForPrintAt DateTime?
  approvedById    String?
  approvedBy      User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  printStartedAt  DateTime?
  printCompletedAt DateTime?

  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  trackingNumber  String?
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
